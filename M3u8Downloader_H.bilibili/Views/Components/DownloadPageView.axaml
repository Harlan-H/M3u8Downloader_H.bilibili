<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:M3u8Downloader_H.bilibili.ViewModels.Components"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:DataType="vm:DownloadPageViewModel"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="M3u8Downloader_H.bilibili.DownloadPageView">
  <Grid RowDefinitions="200, *, 50">
        <Grid ColumnDefinitions="auto,*">
			<Image asyncImageLoader:ImageLoader.Source="{Binding Thumbnail}" />
            <StackPanel Margin="10,0,0,0" Grid.Column="1">
				 <TextBlock Text="{Binding Title}"  FontSize="30"  TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="5">
		          <PathIcon Data="{StaticResource up_path}" Width="20" Height="19" Foreground="Black" />
                  <TextBlock Margin="0,5,0,5" Text="{Binding Owner,StringFormat=  {}{0}}" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"  TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Border  Grid.Row="1" BorderThickness="0,1" Margin="5" BorderBrush="{DynamicResource MaterialPrimaryMidBrush}">
        <ListBox 
            ItemsSource="{Binding StreamViewModels}"
            SelectedItems="{Binding SelectedStreamViewModels}"
            SelectionMode="Multiple,Toggle">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8,4,8,4" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,auto">
                        <StackPanel  Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                            <TextBlock  TextTrimming="CharacterEllipsis" FontSize="24" >
								<TextBlock.Text>
									<MultiBinding StringFormat="{}{0})  {1}">
                                        <Binding  Path="Page" />
                                        <Binding  Path="Title" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <Grid ColumnDefinitions="auto,40,*" >
                                <ComboBox Grid.Column="0" HorizontalAlignment="Right" ItemsSource="{Binding StreamInfoItems}" SelectedItem="{Binding SelectedVideoItem}" DisplayMemberBinding="{Binding Display}" />
                                <TextBlock Grid.Column="2" Margin="0,4,0,0" VerticalAlignment="Center">
								    <TextBlock.Text>
									    <MultiBinding StringFormat="📅 {0}    ⏱ {1}" >
										    <Binding Path="CTime" />
                                            <Binding Path="Duration" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                        </StackPanel>
                        
                        <icons:MaterialIcon
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Kind="Check"
                                IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" >
                <Button Command="{Binding ConfirmCommand}"  
                        IsDefault="True"
                        Margin="8" >
                    <Button.Content>
                        <TextBlock>
                            <Run Text="下载"/>
                            <Run Text="(" /><Run Text="{Binding SelectedStreamViewModels.Count,FallbackValue=0,Mode=OneWay}" /><Run Text=")"/>
                        </TextBlock>
                    </Button.Content>
                </Button>
                <Button Margin="8" Content="取消" IsCancel="True" Command="{Binding CancelCommand}"/>
        </StackPanel>

    </Grid>
</UserControl>
